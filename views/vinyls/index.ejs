<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vinyl Collection</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="collection-body">
    <div class="collection-wrapper">
        <% if (vinyls.length === 0) { %>
            <div class="empty-state">
                <h2>No vinyls yet</h2>
                <p>Start scanning</p>
                <a href="/vinyls/add" class="btn btn-primary">+</a>
            </div>
        <% } else { %>
            <!-- Minimalist Controls Bar -->
            <div class="controls-bar">
                <input type="text"
                       id="searchInput"
                       placeholder="Search..."
                       autocomplete="off">

                <!-- Desktop Controls -->
                <div class="sort-controls desktop-only">
                    <button class="sort-btn active" data-sort="recent">Recent</button>
                    <button class="sort-btn" data-sort="artist">Artist</button>
                    <button class="sort-btn" data-sort="album">Album</button>
                    <button class="sort-btn" data-sort="year">Year</button>
                </div>

                <!-- Filter Controls -->
                <div class="filter-controls desktop-only">
                    <button class="filter-btn active" data-filter="all">All</button>
                    <button class="filter-btn" data-filter="album">Albums</button>
                    <button class="filter-btn" data-filter="single">Singles</button>
                </div>

                <!-- Grid Size Selector -->
                <div class="grid-size-selector">
                    <button class="grid-size-btn" data-size="3" title="3 columns">⚏</button>
                    <button class="grid-size-btn active" data-size="5" title="5 columns">⚏⚏</button>
                    <button class="grid-size-btn desktop-only" data-size="10" title="10 columns">⚏⚏⚏</button>
                </div>

                <button class="btn-logout-desktop desktop-only" id="logoutBtnDesktop" style="display: none;" title="Logout">
                    🔓
                </button>

                <a href="/vinyls/add" class="btn-add-minimal desktop-only">+</a>

                <!-- Mobile Hamburger Menu -->
                <button class="hamburger-btn mobile-only" id="hamburgerBtn">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>

            <!-- Mobile Menu Overlay -->
            <div class="mobile-menu" id="mobileMenu">
                <div class="mobile-menu-content">
                    <div class="mobile-menu-header">
                        <h3>Menu</h3>
                        <button class="close-menu" id="closeMenu">×</button>
                    </div>
                    <div class="mobile-menu-section">
                        <h4>Sort By</h4>
                        <button class="sort-btn-mobile active" data-sort="recent">Recent</button>
                        <button class="sort-btn-mobile" data-sort="artist">Artist</button>
                        <button class="sort-btn-mobile" data-sort="album">Album</button>
                        <button class="sort-btn-mobile" data-sort="year">Year</button>
                    </div>
                    <div class="mobile-menu-section">
                        <h4>Filter</h4>
                        <button class="filter-btn-mobile active" data-filter="all">All</button>
                        <button class="filter-btn-mobile" data-filter="album">Albums</button>
                        <button class="filter-btn-mobile" data-filter="single">Singles</button>
                    </div>
                    <div class="mobile-menu-section">
                        <a href="/vinyls/add" class="btn-add-mobile">+ Add Vinyl</a>
                    </div>
                    <div class="mobile-menu-section">
                        <button class="btn-logout-mobile" id="logoutBtn" style="display: none;">
                            <span>🔓</span> Logout
                        </button>
                    </div>
                </div>
            </div>

            <!-- Vinyl Grid -->
            <div class="vinyl-grid-modern" id="vinylGrid">
                <% vinyls.forEach(vinyl => {
                    // Extract clean album name by removing artist prefix
                    let cleanAlbum = vinyl.title;
                    if (vinyl.artist && vinyl.title) {
                        // Try to remove "Artist - " or "Artist: " from the beginning
                        const artistPrefix = new RegExp(`^${vinyl.artist.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\s*[-:]\\s*`, 'i');
                        cleanAlbum = vinyl.title.replace(artistPrefix, '').trim();
                        // If nothing changed, try just removing artist followed by space
                        if (cleanAlbum === vinyl.title) {
                            const artistPrefixSimple = new RegExp(`^${vinyl.artist.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\s+`, 'i');
                            cleanAlbum = vinyl.title.replace(artistPrefixSimple, '').trim();
                        }
                    }
                %>
                    <div class="vinyl-item"
                         data-id="<%= vinyl.id %>"
                         data-artist="<%= vinyl.artist.toLowerCase() %>"
                         data-album="<%= cleanAlbum.toLowerCase() %>"
                         data-year="<%= vinyl.year || '0' %>"
                         data-created="<%= vinyl.createdAt %>"
                         data-type="<%= vinyl.type || 'album' %>">
                        <a href="/vinyls/<%= vinyl.id %>" class="vinyl-cover">
                            <img src="<%= vinyl.coverUrl %>" alt="<%= vinyl.title %>">
                            <div class="vinyl-overlay">
                                <div class="vinyl-overlay-content">
                                    <h3><%= vinyl.title %></h3>
                                    <p><%= vinyl.artist %></p>
                                    <span class="year-badge"><%= vinyl.year %></span>
                                </div>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>

            <!-- No Results Message -->
            <div id="noResults" class="no-results" style="display: none;">
                <h3>No albums found</h3>
                <p>Try a different search</p>
            </div>
        <% } %>
    </div>

    <script>
        const vinyls = Array.from(document.querySelectorAll('.vinyl-item'));
        const searchInput = document.getElementById('searchInput');
        const vinylGrid = document.getElementById('vinylGrid');
        const noResults = document.getElementById('noResults');
        const mobileMenu = document.getElementById('mobileMenu');
        const hamburgerBtn = document.getElementById('hamburgerBtn');
        const closeMenu = document.getElementById('closeMenu');
        let currentSort = 'recent';
        let currentFilter = 'all';
        let currentGridSize = localStorage.getItem('gridSize') || '5';

        // Set initial grid size from localStorage
        vinylGrid.style.gridTemplateColumns = `repeat(${currentGridSize}, 1fr)`;
        document.querySelector(`.grid-size-btn[data-size="${currentGridSize}"]`)?.classList.add('active');

        // Grid size selector
        document.querySelectorAll('.grid-size-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const size = btn.dataset.size;
                currentGridSize = size;

                // Update active state
                document.querySelectorAll('.grid-size-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                // Update grid
                vinylGrid.style.gridTemplateColumns = `repeat(${size}, 1fr)`;

                // Save to localStorage
                localStorage.setItem('gridSize', size);
            });
        });

        // Mobile menu toggle
        if (hamburgerBtn) {
            hamburgerBtn.addEventListener('click', () => {
                mobileMenu.classList.add('active');
            });
        }

        if (closeMenu) {
            closeMenu.addEventListener('click', () => {
                mobileMenu.classList.remove('active');
            });
        }

        // Close menu when clicking outside
        if (mobileMenu) {
            mobileMenu.addEventListener('click', (e) => {
                if (e.target === mobileMenu) {
                    mobileMenu.classList.remove('active');
                }
            });
        }

        // Filter and search function
        function applyFiltersAndSearch() {
            const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

            let visibleCount = 0;
            vinyls.forEach(vinyl => {
                const artist = vinyl.dataset.artist;
                const album = vinyl.dataset.album;
                const type = vinyl.dataset.type || 'album';

                // Check if matches search
                const matchesSearch = query.length === 0 || query.length >= 2 && (artist.includes(query) || album.includes(query));

                // Check if matches filter
                const matchesFilter = currentFilter === 'all' || type === currentFilter;

                // Show only if matches both
                const shouldShow = matchesSearch && matchesFilter;
                vinyl.style.display = shouldShow ? '' : 'none';
                if (shouldShow) visibleCount++;
            });

            noResults.style.display = visibleCount === 0 ? 'block' : 'none';
            vinylGrid.style.display = visibleCount === 0 ? 'none' : 'grid';
        }

        // Search functionality
        if (searchInput) {
            searchInput.addEventListener('input', () => {
                applyFiltersAndSearch();
            });
        }

        // Sort function
        function sortVinyls(sortType) {
            const sorted = [...vinyls].sort((a, b) => {
                switch(sortType) {
                    case 'artist':
                        return a.dataset.artist.localeCompare(b.dataset.artist);
                    case 'album':
                        return a.dataset.album.localeCompare(b.dataset.album);
                    case 'year':
                        return parseInt(b.dataset.year) - parseInt(a.dataset.year);
                    case 'recent':
                    default:
                        return new Date(b.dataset.created) - new Date(a.dataset.created);
                }
            });

            sorted.forEach(vinyl => vinylGrid.appendChild(vinyl));
        }

        // Desktop sort functionality
        document.querySelectorAll('.sort-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const sortType = btn.dataset.sort;
                currentSort = sortType;
                sortVinyls(sortType);
            });
        });

        // Mobile sort functionality
        document.querySelectorAll('.sort-btn-mobile').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.sort-btn-mobile').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const sortType = btn.dataset.sort;
                currentSort = sortType;
                sortVinyls(sortType);

                // Close mobile menu
                mobileMenu.classList.remove('active');
            });
        });

        // Desktop filter functionality
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                currentFilter = btn.dataset.filter;
                applyFiltersAndSearch();
            });
        });

        // Mobile filter functionality
        document.querySelectorAll('.filter-btn-mobile').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.filter-btn-mobile').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                currentFilter = btn.dataset.filter;
                applyFiltersAndSearch();

                // Close mobile menu
                mobileMenu.classList.remove('active');
            });
        });

        // Check authentication status and show/hide logout button
        function updateLogoutButton() {
            const logoutBtnMobile = document.getElementById('logoutBtn');
            const logoutBtnDesktop = document.getElementById('logoutBtnDesktop');

            if (PINAuth && PINAuth.isAuthenticated()) {
                if (logoutBtnMobile) logoutBtnMobile.style.display = 'block';
                if (logoutBtnDesktop) logoutBtnDesktop.style.display = 'inline-block';
            } else {
                if (logoutBtnMobile) logoutBtnMobile.style.display = 'none';
                if (logoutBtnDesktop) logoutBtnDesktop.style.display = 'none';
            }
        }

        // Logout functionality
        function logout() {
            if (confirm('Are you sure you want to logout?')) {
                PINAuth.logout();
                updateLogoutButton();
                alert('✓ Logged out successfully');
            }
        }

        // Initialize logout buttons
        document.addEventListener('DOMContentLoaded', () => {
            const logoutBtnMobile = document.getElementById('logoutBtn');
            const logoutBtnDesktop = document.getElementById('logoutBtnDesktop');

            if (logoutBtnMobile) {
                logoutBtnMobile.addEventListener('click', logout);
            }

            if (logoutBtnDesktop) {
                logoutBtnDesktop.addEventListener('click', logout);
            }

            updateLogoutButton();
        });
    </script>
    <script src="/js/auth.js"></script>
</body>
</html>

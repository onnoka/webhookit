<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vinyl Collection</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="collection-body">
    <div class="collection-wrapper">
        <% if (vinyls.length === 0) { %>
            <div class="empty-state">
                <h2>No vinyls yet</h2>
                <p>Start scanning</p>
                <a href="/vinyls/add" class="btn btn-primary">+</a>
            </div>
        <% } else { %>
            <!-- Minimalist Controls Bar -->
            <div class="controls-bar">
                <input type="text"
                       id="searchInput"
                       placeholder="Search..."
                       autocomplete="off">

                <!-- Desktop Controls -->
                <div class="sort-controls desktop-only">
                    <button class="sort-btn active" data-sort="recent">Recent</button>
                    <button class="sort-btn" data-sort="artist">Artist</button>
                    <button class="sort-btn" data-sort="album">Album</button>
                    <button class="sort-btn" data-sort="year">Year</button>
                </div>

                <a href="/vinyls/add" class="btn-add-minimal desktop-only">+</a>

                <!-- Mobile Hamburger Menu -->
                <button class="hamburger-btn mobile-only" id="hamburgerBtn">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>

            <!-- Mobile Menu Overlay -->
            <div class="mobile-menu" id="mobileMenu">
                <div class="mobile-menu-content">
                    <div class="mobile-menu-header">
                        <h3>Menu</h3>
                        <button class="close-menu" id="closeMenu">×</button>
                    </div>
                    <div class="mobile-menu-section">
                        <h4>Sort By</h4>
                        <button class="sort-btn-mobile active" data-sort="recent">Recent</button>
                        <button class="sort-btn-mobile" data-sort="artist">Artist</button>
                        <button class="sort-btn-mobile" data-sort="album">Album</button>
                        <button class="sort-btn-mobile" data-sort="year">Year</button>
                    </div>
                    <div class="mobile-menu-section">
                        <a href="/vinyls/add" class="btn-add-mobile">+ Add Vinyl</a>
                    </div>
                </div>
            </div>

            <!-- Vinyl Grid -->
            <div class="vinyl-grid-modern" id="vinylGrid">
                <% vinyls.forEach(vinyl => { %>
                    <div class="vinyl-item"
                         data-id="<%= vinyl.id %>"
                         data-artist="<%= vinyl.artist.toLowerCase() %>"
                         data-album="<%= vinyl.title.toLowerCase() %>"
                         data-year="<%= vinyl.year || '0' %>"
                         data-created="<%= vinyl.createdAt %>">
                        <a href="/vinyls/<%= vinyl.id %>" class="vinyl-cover">
                            <img src="<%= vinyl.coverUrl %>" alt="<%= vinyl.title %>">
                            <div class="vinyl-overlay">
                                <div class="vinyl-overlay-content">
                                    <h3><%= vinyl.title %></h3>
                                    <p><%= vinyl.artist %></p>
                                    <span class="year-badge"><%= vinyl.year %></span>
                                </div>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>

            <!-- No Results Message -->
            <div id="noResults" class="no-results" style="display: none;">
                <h3>No albums found</h3>
                <p>Try a different search</p>
            </div>
        <% } %>
    </div>

    <script>
        const vinyls = Array.from(document.querySelectorAll('.vinyl-item'));
        const searchInput = document.getElementById('searchInput');
        const vinylGrid = document.getElementById('vinylGrid');
        const noResults = document.getElementById('noResults');
        const mobileMenu = document.getElementById('mobileMenu');
        const hamburgerBtn = document.getElementById('hamburgerBtn');
        const closeMenu = document.getElementById('closeMenu');
        let currentSort = 'recent';

        // Mobile menu toggle
        if (hamburgerBtn) {
            hamburgerBtn.addEventListener('click', () => {
                mobileMenu.classList.add('active');
            });
        }

        if (closeMenu) {
            closeMenu.addEventListener('click', () => {
                mobileMenu.classList.remove('active');
            });
        }

        // Close menu when clicking outside
        if (mobileMenu) {
            mobileMenu.addEventListener('click', (e) => {
                if (e.target === mobileMenu) {
                    mobileMenu.classList.remove('active');
                }
            });
        }

        // Search functionality
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                const query = e.target.value.toLowerCase().trim();

                if (query.length < 2 && query.length > 0) {
                    return;
                }

                let visibleCount = 0;
                vinyls.forEach(vinyl => {
                    const artist = vinyl.dataset.artist;
                    const album = vinyl.dataset.album;
                    const matches = artist.includes(query) || album.includes(query);

                    vinyl.style.display = matches || query.length === 0 ? '' : 'none';
                    if (matches || query.length === 0) visibleCount++;
                });

                noResults.style.display = visibleCount === 0 ? 'block' : 'none';
                vinylGrid.style.display = visibleCount === 0 ? 'none' : 'grid';
            });
        }

        // Sort function
        function sortVinyls(sortType) {
            const sorted = [...vinyls].sort((a, b) => {
                switch(sortType) {
                    case 'artist':
                        return a.dataset.artist.localeCompare(b.dataset.artist);
                    case 'album':
                        return a.dataset.album.localeCompare(b.dataset.album);
                    case 'year':
                        return parseInt(b.dataset.year) - parseInt(a.dataset.year);
                    case 'recent':
                    default:
                        return new Date(b.dataset.created) - new Date(a.dataset.created);
                }
            });

            sorted.forEach(vinyl => vinylGrid.appendChild(vinyl));
        }

        // Desktop sort functionality
        document.querySelectorAll('.sort-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const sortType = btn.dataset.sort;
                currentSort = sortType;
                sortVinyls(sortType);
            });
        });

        // Mobile sort functionality
        document.querySelectorAll('.sort-btn-mobile').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.sort-btn-mobile').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const sortType = btn.dataset.sort;
                currentSort = sortType;
                sortVinyls(sortType);

                // Close mobile menu
                mobileMenu.classList.remove('active');
            });
        });
    </script>
</body>
</html>

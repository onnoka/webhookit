<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Vinyl Collection</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="collection-container">
        <header class="collection-header">
            <h1>🎵 My Vinyl Collection</h1>
            <a href="/vinyls/add" class="btn btn-add">+</a>
        </header>

        <% if (vinyls.length === 0) { %>
            <div class="empty-state">
                <h2>No vinyls yet!</h2>
                <p>Start building your collection by scanning a barcode.</p>
                <a href="/vinyls/add" class="btn btn-primary">Scan First Vinyl</a>
            </div>
        <% } else { %>
            <!-- Search and Sort Controls -->
            <div class="controls">
                <div class="search-container">
                    <input type="text"
                           id="searchInput"
                           placeholder="🔍 Search your collection..."
                           autocomplete="off">
                </div>
                <div class="sort-container">
                    <label>Sort:</label>
                    <button class="sort-btn active" data-sort="recent">Recent</button>
                    <button class="sort-btn" data-sort="artist">Artist</button>
                    <button class="sort-btn" data-sort="album">Album</button>
                    <button class="sort-btn" data-sort="year">Year</button>
                </div>
            </div>

            <!-- Vinyl Grid -->
            <div class="vinyl-grid-modern" id="vinylGrid">
                <% vinyls.forEach(vinyl => { %>
                    <div class="vinyl-item"
                         data-id="<%= vinyl.id %>"
                         data-artist="<%= vinyl.artist.toLowerCase() %>"
                         data-album="<%= vinyl.title.toLowerCase() %>"
                         data-year="<%= vinyl.year || '0' %>"
                         data-created="<%= vinyl.createdAt %>">
                        <a href="/vinyls/<%= vinyl.id %>" class="vinyl-cover">
                            <img src="<%= vinyl.coverUrl %>" alt="<%= vinyl.title %>">
                            <div class="vinyl-overlay">
                                <div class="vinyl-overlay-content">
                                    <h3><%= vinyl.title %></h3>
                                    <p><%= vinyl.artist %></p>
                                    <span class="year-badge"><%= vinyl.year %></span>
                                </div>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>

            <!-- No Results Message -->
            <div id="noResults" class="no-results" style="display: none;">
                <h3>No albums found</h3>
                <p>Try a different search term</p>
            </div>
        <% } %>
    </div>

    <script>
        const vinyls = Array.from(document.querySelectorAll('.vinyl-item'));
        const searchInput = document.getElementById('searchInput');
        const vinylGrid = document.getElementById('vinylGrid');
        const noResults = document.getElementById('noResults');
        let currentSort = 'recent';

        // Search functionality
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                const query = e.target.value.toLowerCase().trim();

                if (query.length < 2 && query.length > 0) {
                    return; // Wait for at least 2 characters
                }

                let visibleCount = 0;
                vinyls.forEach(vinyl => {
                    const artist = vinyl.dataset.artist;
                    const album = vinyl.dataset.album;
                    const matches = artist.includes(query) || album.includes(query);

                    vinyl.style.display = matches || query.length === 0 ? '' : 'none';
                    if (matches || query.length === 0) visibleCount++;
                });

                // Show/hide no results message
                noResults.style.display = visibleCount === 0 ? 'block' : 'none';
                vinylGrid.style.display = visibleCount === 0 ? 'none' : 'grid';
            });
        }

        // Sort functionality
        document.querySelectorAll('.sort-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                // Update active button
                document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const sortType = btn.dataset.sort;
                currentSort = sortType;

                // Sort vinyls
                const sorted = [...vinyls].sort((a, b) => {
                    switch(sortType) {
                        case 'artist':
                            return a.dataset.artist.localeCompare(b.dataset.artist);
                        case 'album':
                            return a.dataset.album.localeCompare(b.dataset.album);
                        case 'year':
                            return parseInt(b.dataset.year) - parseInt(a.dataset.year);
                        case 'recent':
                        default:
                            return new Date(b.dataset.created) - new Date(a.dataset.created);
                    }
                });

                // Re-append in sorted order
                sorted.forEach(vinyl => vinylGrid.appendChild(vinyl));
            });
        });
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= vinyl.title %> - Vinyl Collection</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <a href="/vinyls" class="btn btn-back">← Back to Collection</a>
            <div class="header-actions">
                <button onclick="playAlbumOnSpotify('<%= vinyl.artist.replace(/'/g, "\\'") %>', '<%= vinyl.title.replace(/'/g, "\\'") %>')" class="btn btn-spotify">
                    🎵 Play Album on Spotify
                </button>
                <button onclick="refreshTracks('<%= vinyl.id %>')" class="btn btn-secondary">🔄 Refresh Tracks</button>
                <button onclick="deleteVinyl('<%= vinyl.id %>')" class="btn btn-danger">🗑️ Delete</button>
            </div>
        </header>

        <div class="detail-page">
            <div class="detail-cover">
                <img src="<%= vinyl.coverUrl %>" alt="<%= vinyl.title %>">
            </div>

            <div class="detail-info">
                <h1><%= vinyl.title %></h1>

                <div class="info-section">
                    <h3>Artist</h3>
                    <p><%= vinyl.artist %></p>
                </div>

                <div class="info-section">
                    <h3>Year</h3>
                    <p><%= vinyl.year %></p>
                </div>

                <div class="info-section">
                    <h3>Label</h3>
                    <p><%= vinyl.label %></p>
                </div>

                <div class="info-section">
                    <h3>Barcode</h3>
                    <p><code><%= vinyl.barcode %></code></p>
                </div>

                <div class="info-section">
                    <h3>Added to Collection</h3>
                    <p><%= new Date(vinyl.createdAt).toLocaleDateString('nl-NL', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    }) %></p>
                </div>
            </div>
        </div>

        <% if (vinyl.tracks && vinyl.tracks.length > 0) { %>
        <div class="tracklist-section">
            <h2>🎵 Track Listing</h2>
            <div class="tracklist">
                <% vinyl.tracks.forEach((track, index) => { %>
                    <div class="track-item">
                        <span class="track-position"><%= track.position || (index + 1) %></span>
                        <span class="track-title"><%= track.title %></span>
                        <% if (track.duration) { %>
                            <span class="track-duration"><%= track.duration %></span>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        </div>
        <% } %>

    </div>

    <script>
        async function playAlbumOnSpotify(artist, album) {
            try {
                const response = await fetch(`/api/spotify/album?artist=${encodeURIComponent(artist)}&album=${encodeURIComponent(album)}`);
                const data = await response.json();

                if (data.success && data.spotifyUri) {
                    // Open Spotify in background using hidden iframe
                    // This keeps focus on the app while starting Spotify
                    let iframe = document.getElementById('spotify-launcher');
                    if (!iframe) {
                        iframe = document.createElement('iframe');
                        iframe.id = 'spotify-launcher';
                        iframe.style.display = 'none';
                        document.body.appendChild(iframe);
                    }
                    iframe.src = data.spotifyUri;

                    // Show feedback
                    const allButtons = document.querySelectorAll('.btn-spotify');
                    allButtons.forEach(btn => {
                        const originalText = btn.innerHTML;
                        btn.innerHTML = '✓ Spotify gestart...';
                        setTimeout(() => {
                            btn.innerHTML = originalText;
                        }, 2000);
                    });
                } else {
                    alert('⚠️ Album niet gevonden op Spotify');
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }

        async function deleteVinyl(id) {
            if (!confirm('Are you sure you want to delete this vinyl?')) return;

            try {
                const response = await fetch(`/api/vinyls/${id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    window.location.href = '/vinyls';
                } else {
                    alert('Error deleting vinyl');
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }

        async function refreshTracks(id) {
            if (!confirm('Refresh track listing from Discogs? This may take a few seconds.')) return;

            try {
                const response = await fetch(`/api/vinyls/${id}/refresh`, {
                    method: 'POST'
                });

                const data = await response.json();
                if (data.success) {
                    alert('✓ Tracks refreshed!');
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }
    </script>
</body>
</html>

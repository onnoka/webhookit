<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= vinyl.title %> - Vinyl Collection</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="detail-body">
    <!-- Top Bar -->
    <div class="detail-top-bar">
        <a href="/vinyls" class="btn-back-minimal">← Back</a>
        <div class="detail-actions">
            <button onclick="playAlbumOnSpotify()" class="btn-action-minimal">
                🎵 Play
            </button>
            <button onclick="deleteVinyl('<%= vinyl.id %>')" class="btn-action-minimal btn-danger-minimal">
                Delete
            </button>
        </div>
    </div>

    <!-- Main Content -->
    <div class="detail-container">
        <!-- Cover Section -->
        <div class="detail-cover-section">
            <img id="vinylCover" src="<%= vinyl.coverUrl %>" alt="<%= vinyl.title %>" class="detail-cover-img">

            <!-- Cover Replace Section -->
            <div class="cover-replace-section">
                <h3>Change Cover</h3>
                <input type="text"
                       id="newCoverUrl"
                       placeholder="Paste image URL here..."
                       class="cover-url-input">
                <div class="cover-actions">
                    <button onclick="previewCover()" class="btn-cover-action">Preview</button>
                    <button onclick="saveCover('<%= vinyl.id %>')" class="btn-cover-action btn-save">Save</button>
                    <button onclick="searchCover()" class="btn-cover-action">🔍 Search</button>
                </div>
            </div>
        </div>

        <!-- Info Section -->
        <div class="detail-info-section">
            <h1 class="detail-title"><%= vinyl.title %></h1>
            <p class="detail-artist"><%= vinyl.artist %></p>

            <div class="detail-meta">
                <div class="meta-item">
                    <span class="meta-label">Year</span>
                    <span class="meta-value"><%= vinyl.year %></span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Label</span>
                    <span class="meta-value"><%= vinyl.label %></span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Barcode</span>
                    <span class="meta-value"><%= vinyl.barcode %></span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Added</span>
                    <span class="meta-value"><%= new Date(vinyl.createdAt).toLocaleDateString('nl-NL', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    }) %></span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Type</span>
                    <select id="vinylType" class="type-select-detail" onchange="updateVinylType('<%= vinyl.id %>')">
                        <option value="album" <%= (vinyl.type || 'album') === 'album' ? 'selected' : '' %>>Album</option>
                        <option value="single" <%= vinyl.type === 'single' ? 'selected' : '' %>>Single</option>
                    </select>
                </div>
            </div>

            <!-- Spotify Player Container -->
            <div id="spotify-player-container" class="spotify-player-minimal">
                <button onclick="closeSpotifyPlayer()" class="close-player">×</button>
                <iframe id="spotify-player"
                        style="border-radius:8px; width: 100%; height: 352px;"
                        frameBorder="0"
                        allowfullscreen=""
                        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                        loading="lazy">
                </iframe>
            </div>

            <!-- Tracklist -->
            <% if (vinyl.tracks && vinyl.tracks.length > 0) { %>
            <div class="detail-tracklist">
                <h2>Tracks</h2>
                <div class="track-list">
                    <% vinyl.tracks.forEach((track, index) => { %>
                        <div class="track">
                            <span class="track-num"><%= track.position || (index + 1) %></span>
                            <span class="track-name"><%= track.title %></span>
                            <% if (track.duration) { %>
                                <span class="track-time"><%= track.duration %></span>
                            <% } %>
                        </div>
                    <% }); %>
                </div>
            </div>
            <% } %>
        </div>
    </div>

    <script src="/js/auth.js"></script>
    <script>
        let originalCoverUrl = '<%= vinyl.coverUrl %>';
        const vinylData = {
            artist: <%- JSON.stringify(vinyl.artist) %>,
            title: <%- JSON.stringify(vinyl.title) %>,
            tracks: <%- JSON.stringify(vinyl.tracks || []) %>
        };

        function isMobile() {
            return /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
        }

        async function playAlbumOnSpotify() {
            const artist = vinylData.artist;
            const album = vinylData.title;
            // Check if we have tracks for this vinyl
            const hasTracks = <%= (vinyl.tracks && vinyl.tracks.length > 0) ? 'true' : 'false' %>;

            if (hasTracks) {
                // Play individual tracks (better for singles/maxi-singles)
                await playVinylTracks(artist);
            } else {
                // Fallback to album search if no tracks available
                await playAlbumFallback(artist, album);
            }
        }

        async function playVinylTracks(artist) {
            try {
                const tracks = vinylData.tracks;

                // Search for each track on Spotify
                const response = await fetch('/api/spotify/tracks', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ artist, tracks })
                });

                const data = await response.json();

                if (data.success && data.tracks) {
                    const foundTracks = data.tracks.filter(t => t.found);

                    if (foundTracks.length > 0) {
                        if (isMobile()) {
                            // Open first track in Spotify app
                            window.location.href = foundTracks[0].spotifyUrl;
                        } else {
                            // Show track list with play buttons
                            showTrackPlayer(data.tracks);
                        }
                    } else {
                        alert('⚠️ Tracks niet gevonden op Spotify');
                    }
                } else {
                    alert('⚠️ Kon tracks niet zoeken op Spotify');
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }

        async function playAlbumFallback(artist, album) {
            try {
                const response = await fetch(`/api/spotify/album?artist=${encodeURIComponent(artist)}&album=${encodeURIComponent(album)}`);
                const data = await response.json();

                if (data.success && data.spotifyId) {
                    if (isMobile()) {
                        window.location.href = data.spotifyUri;
                    } else {
                        const playerContainer = document.getElementById('spotify-player-container');
                        const playerIframe = document.getElementById('spotify-player');
                        playerIframe.src = `https://open.spotify.com/embed/album/${data.spotifyId}?utm_source=generator`;
                        playerContainer.style.display = 'block';
                        playerContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                } else {
                    alert('⚠️ Album niet gevonden op Spotify');
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }

        function showTrackPlayer(tracks) {
            const playerContainer = document.getElementById('spotify-player-container');
            const playerIframe = document.getElementById('spotify-player');

            // Build track list HTML
            let trackListHTML = '<div style="padding: 20px; max-height: 400px; overflow-y: auto;">';
            trackListHTML += '<h3 style="color: #fff; margin-bottom: 15px;">🎵 Tracks on Spotify</h3>';

            tracks.forEach((track, index) => {
                if (track.found) {
                    trackListHTML += `
                        <div style="display: flex; align-items: center; gap: 10px; padding: 10px; border-bottom: 1px solid rgba(255,255,255,0.1); cursor: pointer;"
                             onclick="playTrack('${track.spotifyUrl}')"
                             onmouseover="this.style.background='rgba(255,255,255,0.05)'"
                             onmouseout="this.style.background='transparent'">
                            <span style="color: rgba(255,255,255,0.5); font-size: 12px; min-width: 30px;">${track.position || (index + 1)}</span>
                            <div style="flex: 1;">
                                <div style="color: #fff; font-size: 14px;">${track.originalTitle}</div>
                                <div style="color: rgba(255,255,255,0.5); font-size: 12px;">✓ ${track.spotifyName}</div>
                            </div>
                            <button style="background: #1DB954; color: #fff; border: none; padding: 8px 16px; border-radius: 20px; font-size: 12px; cursor: pointer;">
                                ▶ Play
                            </button>
                        </div>
                    `;
                } else {
                    trackListHTML += `
                        <div style="display: flex; align-items: center; gap: 10px; padding: 10px; border-bottom: 1px solid rgba(255,255,255,0.1); opacity: 0.5;">
                            <span style="color: rgba(255,255,255,0.5); font-size: 12px; min-width: 30px;">${track.position || (index + 1)}</span>
                            <div style="flex: 1;">
                                <div style="color: #fff; font-size: 14px;">${track.originalTitle}</div>
                                <div style="color: rgba(255,100,100,0.8); font-size: 12px;">✗ Niet gevonden op Spotify</div>
                            </div>
                        </div>
                    `;
                }
            });

            trackListHTML += '</div>';

            // Replace iframe with track list
            playerIframe.style.display = 'none';
            let trackListEl = playerContainer.querySelector('.track-list-container');
            if (!trackListEl) {
                trackListEl = document.createElement('div');
                trackListEl.className = 'track-list-container';
                playerContainer.appendChild(trackListEl);
            }
            trackListEl.innerHTML = trackListHTML;

            playerContainer.style.display = 'block';
            playerContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function playTrack(spotifyUrl) {
            window.open(spotifyUrl, '_blank');
        }

        function closeSpotifyPlayer() {
            const playerContainer = document.getElementById('spotify-player-container');
            const playerIframe = document.getElementById('spotify-player');
            playerContainer.style.display = 'none';
            playerIframe.src = '';
        }

        async function deleteVinyl(id) {
            if (!confirm('Are you sure you want to delete this vinyl?')) return;

            try {
                const response = await PINAuth.protectedFetch(`/api/vinyls/${id}`, { method: 'DELETE' });
                if (response.ok) {
                    window.location.href = '/vinyls';
                } else {
                    alert('Error deleting vinyl');
                }
            } catch (error) {
                if (error.message === 'Authentication cancelled') {
                    return;
                }
                alert('Error: ' + error.message);
            }
        }

        function previewCover() {
            const url = document.getElementById('newCoverUrl').value.trim();
            if (!url) {
                alert('Please paste an image URL first');
                return;
            }

            const img = document.getElementById('vinylCover');
            img.src = url;
        }

        async function saveCover(vinylId) {
            const url = document.getElementById('newCoverUrl').value.trim();
            if (!url) {
                alert('Please paste an image URL first');
                return;
            }

            if (!confirm('Save this cover image?')) return;

            try {
                const response = await PINAuth.protectedFetch(`/api/vinyls/${vinylId}/cover`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ coverUrl: url })
                });

                const result = await response.json();
                if (result.success) {
                    alert('✓ Cover saved!');
                    originalCoverUrl = result.coverUrl;
                    document.getElementById('newCoverUrl').value = '';
                    location.reload();
                } else {
                    alert('Error: ' + result.message);
                }
            } catch (error) {
                if (error.message === 'Authentication cancelled') {
                    document.getElementById('vinylCover').src = originalCoverUrl;
                    return;
                }
                alert('Error: ' + error.message);
                // Restore original on error
                document.getElementById('vinylCover').src = originalCoverUrl;
            }
        }

        function searchCover() {
            const artist = '<%= vinyl.artist.replace(/'/g, "\\'") %>';
            const album = '<%= vinyl.title.replace(/'/g, "\\'") %>';
            const searchQuery = `${artist} ${album} vinyl cover high quality`;
            window.open(`https://www.google.com/search?tbm=isch&q=${encodeURIComponent(searchQuery)}`, '_blank');
        }

        async function updateVinylType(vinylId) {
            const selectedType = document.getElementById('vinylType').value;
            const select = document.getElementById('vinylType');
            const originalValue = select.value;

            try {
                const response = await PINAuth.protectedFetch(`/api/vinyls/${vinylId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ type: selectedType })
                });

                const result = await response.json();
                if (result.success) {
                    // Visual feedback
                    select.style.background = 'rgba(0, 255, 0, 0.2)';
                    setTimeout(() => {
                        select.style.background = '';
                    }, 500);
                } else {
                    alert('Error updating type: ' + result.message);
                    select.value = originalValue;
                }
            } catch (error) {
                if (error.message === 'Authentication cancelled') {
                    // Restore original value
                    select.value = originalValue;
                    return;
                }
                alert('Error: ' + error.message);
                select.value = originalValue;
            }
        }
    </script>
</body>
</html>

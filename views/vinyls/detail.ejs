<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= vinyl.title %> - Vinyl Collection</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <a href="/vinyls" class="btn btn-back">← Back to Collection</a>
            <div class="header-actions">
                <button onclick="refreshTracks('<%= vinyl.id %>')" class="btn btn-secondary">🔄 Refresh Tracks</button>
                <button onclick="deleteVinyl('<%= vinyl.id %>')" class="btn btn-danger">🗑️ Delete</button>
            </div>
        </header>

        <div class="detail-page">
            <div class="detail-cover">
                <img src="<%= vinyl.coverUrl %>" alt="<%= vinyl.title %>">
            </div>

            <div class="detail-info">
                <h1><%= vinyl.title %></h1>

                <div class="info-section">
                    <h3>Artist</h3>
                    <p><%= vinyl.artist %></p>
                </div>

                <div class="info-section">
                    <h3>Year</h3>
                    <p><%= vinyl.year %></p>
                </div>

                <div class="info-section">
                    <h3>Label</h3>
                    <p><%= vinyl.label %></p>
                </div>

                <div class="info-section">
                    <h3>Barcode</h3>
                    <p><code><%= vinyl.barcode %></code></p>
                </div>

                <div class="info-section">
                    <h3>Added to Collection</h3>
                    <p><%= new Date(vinyl.createdAt).toLocaleDateString('nl-NL', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    }) %></p>
                </div>
            </div>
        </div>

        <% if (vinyl.tracks && vinyl.tracks.length > 0) { %>
        <div class="tracklist-section">
            <h2>🎵 Track Listing</h2>
            <div class="tracklist">
                <% vinyl.tracks.forEach((track, index) => { %>
                    <div class="track-item" id="track-<%= index %>">
                        <div class="track-info">
                            <span class="track-position"><%= track.position || (index + 1) %></span>
                            <span class="track-title"><%= track.title %></span>
                            <% if (track.duration) { %>
                                <span class="track-duration"><%= track.duration %></span>
                            <% } %>
                        </div>
                        <div class="track-controls">
                            <button onclick="playTrack('<%= vinyl.artist.replace(/'/g, "\\'") %>', '<%= track.title.replace(/'/g, "\\'") %>', <%= index %>)"
                                    class="spotify-play-btn" id="play-btn-<%= index %>">
                                ▶ Play
                            </button>
                            <audio class="track-audio" id="audio-<%= index %>" style="display: none;"></audio>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
        <% } %>

    </div>

    <script>
        let currentlyPlayingIndex = null;

        async function deleteVinyl(id) {
            if (!confirm('Are you sure you want to delete this vinyl?')) return;

            try {
                const response = await fetch(`/api/vinyls/${id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    window.location.href = '/vinyls';
                } else {
                    alert('Error deleting vinyl');
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }

        async function refreshTracks(id) {
            if (!confirm('Refresh track listing from Discogs? This may take a few seconds.')) return;

            try {
                const response = await fetch(`/api/vinyls/${id}/refresh`, {
                    method: 'POST'
                });

                const data = await response.json();
                if (data.success) {
                    alert('✓ Tracks refreshed!');
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (error) {
                alert('Error: ' + error.message);
            }
        }

        async function playTrack(artist, trackName, index) {
            const audio = document.getElementById(`audio-${index}`);
            const button = document.getElementById(`play-btn-${index}`);
            const trackItem = document.getElementById(`track-${index}`);

            // If this track is already playing, pause it
            if (currentlyPlayingIndex === index && !audio.paused) {
                audio.pause();
                button.innerHTML = '▶ Play';
                button.classList.remove('playing');
                trackItem.classList.remove('playing');
                return;
            }

            // Stop any currently playing track
            if (currentlyPlayingIndex !== null && currentlyPlayingIndex !== index) {
                const prevAudio = document.getElementById(`audio-${currentlyPlayingIndex}`);
                const prevButton = document.getElementById(`play-btn-${currentlyPlayingIndex}`);
                const prevTrack = document.getElementById(`track-${currentlyPlayingIndex}`);
                prevAudio.pause();
                prevButton.innerHTML = '▶ Play';
                prevButton.classList.remove('playing');
                prevTrack.classList.remove('playing');
            }

            // If audio source is not set yet, fetch it from Spotify
            if (!audio.src) {
                button.innerHTML = '⏳ Loading...';
                button.disabled = true;

                try {
                    const response = await fetch(`/api/spotify/preview?artist=${encodeURIComponent(artist)}&track=${encodeURIComponent(trackName)}`);
                    const data = await response.json();

                    if (data.success && data.previewUrl) {
                        audio.src = data.previewUrl;
                        audio.load();
                    } else {
                        alert('⚠️ No preview available for this track');
                        button.innerHTML = '▶ Play';
                        button.disabled = false;
                        return;
                    }
                } catch (error) {
                    alert('Error loading track: ' + error.message);
                    button.innerHTML = '▶ Play';
                    button.disabled = false;
                    return;
                }

                button.disabled = false;
            }

            // Play the track
            audio.play();
            button.innerHTML = '⏸ Pause';
            button.classList.add('playing');
            trackItem.classList.add('playing');
            currentlyPlayingIndex = index;

            // Reset button when track ends
            audio.onended = () => {
                button.innerHTML = '▶ Play';
                button.classList.remove('playing');
                trackItem.classList.remove('playing');
                currentlyPlayingIndex = null;
            };
        }
    </script>
</body>
</html>

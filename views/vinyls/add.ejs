<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scan Barcode - Vinyl Collection</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://unpkg.com/@zxing/library@latest"></script>
</head>
<body class="scan-body">
    <div class="scan-container">
        <!-- Minimalist Header -->
        <div class="scan-header">
            <a href="/vinyls" class="back-link">← Back</a>
            <h1>Scan Vinyl</h1>
        </div>

        <!-- Scanner Section -->
        <div class="scanner-section-minimal">
            <div id="scanner-container" class="scanner-frame">
                <video id="video" autoplay playsinline></video>
                <div id="scanner-overlay">
                    <div class="scanner-line"></div>
                </div>
            </div>

            <div class="scanner-controls">
                <button id="start-camera" class="scan-btn scan-btn-primary">Start Camera</button>
                <button id="stop-camera" class="scan-btn scan-btn-secondary" style="display:none;">Stop Camera</button>
            </div>

            <div class="manual-input-minimal">
                <div class="input-divider">or</div>
                <input type="text" id="manual-barcode" placeholder="Enter barcode manually" class="barcode-input">
                <button id="manual-search" class="scan-btn scan-btn-primary">Search</button>
            </div>

            <!-- Manual Search by Artist/Title -->
            <div class="search-input-section">
                <div class="input-divider">or</div>
                <div class="search-inputs">
                    <input type="text" id="search-artist" placeholder="Artist name" class="search-input">
                    <input type="text" id="search-title" placeholder="Album title" class="search-input">
                </div>

                <!-- Search Results Dropdown -->
                <div id="search-results" class="search-results" style="display:none;"></div>
            </div>
        </div>

        <!-- Result Section -->
        <div id="result" class="result-section" style="display:none;">
            <div class="result-card">
                <img id="album-cover" src="" alt="Album cover" class="result-cover">
                <div class="result-info">
                    <h2 id="album-title" class="result-title"></h2>
                    <p class="result-artist"><span id="album-artist"></span></p>
                    <div class="result-meta">
                        <span id="album-year"></span>
                        <span class="meta-sep">·</span>
                        <span id="album-label"></span>
                    </div>
                    <p class="result-barcode"><span id="album-barcode"></span></p>
                </div>
                <div class="type-selector">
                    <label for="vinyl-type">Type:</label>
                    <select id="vinyl-type" class="type-dropdown">
                        <option value="album">Album</option>
                        <option value="single">Single</option>
                    </select>
                </div>
                <div class="result-actions">
                    <button id="add-to-collection" class="scan-btn scan-btn-success">Add to Collection</button>
                    <button id="scan-another" class="scan-btn scan-btn-ghost">Scan Another</button>
                </div>
            </div>
        </div>

        <!-- Loading State -->
        <div id="loading" class="loading-state" style="display:none;">
            <div class="loading-spinner"></div>
            <p>Searching...</p>
        </div>
    </div>

    <script src="/js/auth.js"></script>
    <script src="/js/scanner.js"></script>
</body>
</html>

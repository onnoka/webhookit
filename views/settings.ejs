<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - Vinyl Collection</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .settings-body {
            background: #000;
            color: #fff;
            min-height: 100vh;
            padding: 20px;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        .settings-container {
            max-width: 800px;
            margin: 0 auto;
            padding-top: 60px;
        }

        .settings-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .settings-title {
            font-size: 32px;
            font-weight: 300;
            margin: 0;
            flex: 1;
        }

        .settings-section {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 20px;
            font-weight: 400;
            margin: 0 0 20px 0;
            color: rgba(255, 255, 255, 0.9);
        }

        .section-description {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.5);
            margin-bottom: 25px;
            line-height: 1.6;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 14px;
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 8px;
        }

        .form-input {
            width: 100%;
            padding: 12px 16px;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            color: #fff;
            font-size: 15px;
            transition: all 0.2s;
        }

        .form-input:focus {
            outline: none;
            border-color: rgba(255, 255, 255, 0.3);
            background: rgba(0, 0, 0, 0.7);
        }

        .form-input::placeholder {
            color: rgba(255, 255, 255, 0.3);
        }

        .btn-settings {
            padding: 12px 24px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            color: #fff;
            font-size: 15px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-settings:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.3);
        }

        .btn-settings:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-primary {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .btn-primary:hover:not(:disabled) {
            background: rgba(255, 255, 255, 0.15);
        }

        .btn-import {
            background: rgba(30, 215, 96, 0.1);
            border-color: rgba(30, 215, 96, 0.3);
            color: #1ED760;
            font-weight: 500;
        }

        .btn-import:hover:not(:disabled) {
            background: rgba(30, 215, 96, 0.2);
            border-color: rgba(30, 215, 96, 0.5);
        }

        .settings-info {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            background: rgba(30, 215, 96, 0.05);
            border: 1px solid rgba(30, 215, 96, 0.2);
            border-radius: 8px;
            color: #1ED760;
            font-size: 14px;
            margin-top: 15px;
        }

        .settings-warning {
            background: rgba(255, 193, 7, 0.05);
            border-color: rgba(255, 193, 7, 0.2);
            color: #FFC107;
        }

        .help-text {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.4);
            margin-top: 8px;
        }

        .help-link {
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

        .help-link:hover {
            color: rgba(255, 255, 255, 0.9);
            border-bottom-color: rgba(255, 255, 255, 0.5);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .stat-item {
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 15px;
            text-align: center;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 300;
            color: #fff;
            margin-bottom: 5px;
        }

        .stat-label {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.5);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .import-progress {
            display: none;
            margin-top: 20px;
            padding: 20px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
        }

        .progress-bar {
            width: 100%;
            height: 6px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
            overflow: hidden;
            margin-top: 10px;
        }

        .progress-fill {
            height: 100%;
            background: #1ED760;
            width: 0%;
            transition: width 0.3s;
        }

        .progress-text {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 5px;
        }

        @media (max-width: 768px) {
            .settings-container {
                padding-top: 20px;
            }

            .settings-title {
                font-size: 24px;
            }

            .settings-section {
                padding: 20px;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body class="settings-body">
    <div class="settings-container">
        <div class="settings-header">
            <a href="/vinyls" class="btn-settings">← Back</a>
            <h1 class="settings-title">Settings</h1>
        </div>

        <!-- User Info Section -->
        <div class="settings-section">
            <h2 class="section-title">User Information</h2>
            <p class="section-description">Set your username for credential management</p>

            <div class="form-group">
                <label class="form-label" for="username">Username</label>
                <input type="text"
                       id="username"
                       class="form-input"
                       placeholder="Enter username"
                       value="default">
                <p class="help-text">This is used to store your credentials securely</p>
            </div>
        </div>

        <!-- Discogs Integration -->
        <div class="settings-section">
            <h2 class="section-title">Discogs Integration</h2>
            <p class="section-description">Connect your Discogs account to import your vinyl collection</p>

            <div class="form-group">
                <label class="form-label" for="discogsUsername">Discogs Username</label>
                <input type="text"
                       id="discogsUsername"
                       class="form-input"
                       placeholder="Your Discogs username">
            </div>

            <div class="form-group">
                <label class="form-label" for="discogsToken">Personal Access Token</label>
                <input type="password"
                       id="discogsToken"
                       class="form-input"
                       placeholder="Paste your Discogs token here">
                <p class="help-text">
                    Get your token from
                    <a href="https://www.discogs.com/settings/developers"
                       target="_blank"
                       class="help-link">Discogs Developer Settings</a>
                </p>
            </div>

            <button id="saveDiscogsBtn" class="btn-settings btn-primary">Save Discogs Credentials</button>

            <div id="discogsStatus" style="display: none;" class="settings-info">
                <span>✓</span>
                <span>Discogs credentials saved</span>
            </div>

            <div id="importSection" style="display: none; margin-top: 30px;">
                <button id="importBtn" class="btn-settings btn-import">Import Collection from Discogs</button>

                <div id="importProgress" class="import-progress">
                    <p class="progress-text" id="progressText">Importing...</p>
                    <div class="progress-bar">
                        <div class="progress-fill" id="progressFill"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Spotify Integration -->
        <div class="settings-section">
            <h2 class="section-title">Spotify Integration</h2>
            <p class="section-description">Connect Spotify to play your vinyl collection</p>

            <div class="form-group">
                <label class="form-label" for="spotifyClientId">Client ID</label>
                <input type="text"
                       id="spotifyClientId"
                       class="form-input"
                       placeholder="Spotify Client ID">
            </div>

            <div class="form-group">
                <label class="form-label" for="spotifyClientSecret">Client Secret</label>
                <input type="password"
                       id="spotifyClientSecret"
                       class="form-input"
                       placeholder="Spotify Client Secret">
                <p class="help-text">
                    Create an app at
                    <a href="https://developer.spotify.com/dashboard"
                       target="_blank"
                       class="help-link">Spotify Developer Dashboard</a>
                </p>
            </div>

            <button id="saveSpotifyBtn" class="btn-settings btn-primary">Save Spotify Credentials</button>

            <div id="spotifyStatus" style="display: none;" class="settings-info">
                <span>✓</span>
                <span>Spotify credentials saved</span>
            </div>
        </div>

        <!-- Statistics -->
        <div class="settings-section">
            <h2 class="section-title">Collection Statistics</h2>

            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-value" id="statTotal">-</div>
                    <div class="stat-label">Total Vinyls</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="statAlbums">-</div>
                    <div class="stat-label">Albums</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="statSingles">-</div>
                    <div class="stat-label">Singles</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="statLastSync">-</div>
                    <div class="stat-label">Last Sync</div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/auth.js"></script>
    <script src="/js/settings.js"></script>
</body>
</html>
